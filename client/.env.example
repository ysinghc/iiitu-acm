# Production API base (baked in at build time — rebuild to change)
VITE_API_URL=https://api.acmiiitu.in/api

# Google reCAPTCHA v2 sitekey (public; baked in at build time)
VITE_RECAPTCHA_SITE_KEY=

# Hostnames the SPA will serve (comma-separated, no scheme).
# Anything else renders a blocked notice and makes no API calls.
# Local dev (npm run dev) always bypasses this check.
VITE_ALLOWED_HOSTS=acmiiitu.in,www.acmiiitu.in,localhost,127.0.0.1
