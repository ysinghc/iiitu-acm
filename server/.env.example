# Core
MONGODB_URI=mongodb://localhost:27017/iiitu-acm
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173

# Images (optional; local /uploads fallback when absent)
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<cloud-name>

# CORS allowlist (exact origins, comma-separated). Browsers on any other
# origin get a 403. Requests without Origin (curl, health checks) pass.
# Production default is the chapter domain even when this is unset.
ALLOWED_ORIGINS=https://acmiiitu.in,https://www.acmiiitu.in

# Rate limits (per account email where identity exists, else per IP).
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_FORGOT_MAX=5
RATE_LIMIT_FORGOT_WINDOW_MS=900000
RATE_LIMIT_API_MAX=2000
RATE_LIMIT_API_WINDOW_MS=900000

# Outgoing mail. EVERY email is always appended to EMAIL_LOG_FILE.
# Real SMTP delivery happens ONLY when EMAIL_SEND_ENABLED=true.
# Keep it false while SMTP settings are mock data.
EMAIL_LOG_FILE=email.txt
EMAIL_SEND_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey-or-username
SMTP_PASS=secret
MAIL_FROM=IIITU ACM <no-reply@acmiiitu.in>

# First-boot chair account (used only when the users collection is empty)
SEED_CHAIR_EMAIL=chair@acmiiitu.in
SEED_CHAIR_PASSWORD=
SEED_CHAIR_NAME=Chapter Chair
